# --- AI providers ---
GOOGLE_GEMINI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- TossPayments (test) ---
# 개발자센터(API 키 메뉴) 또는 문서 테스트 키. ck=클라이언트(브라우저), sk=시크릿(서버 전용)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 시연(demo) 모드 어드민 시크릿 ---
# 설정 시 숨겨진 어드민 URL로 이 브라우저만 시연 모드 on/off (배포 환경 런타임 토글).
#   켜기: /api/admin/demo?key=<이 값>   끄기: /api/admin/demo?key=<이 값>&off=1
# 시연 모드에선 실제 AI/워커 없이 public/demo/* 이미지로 생성을 흉내내고 쿼터 무제한.
# 비워두면 기능 자체가 비활성(어드민 URL도 404). 길고 추측 불가한 값 권장.
ADMIN_DEMO_SECRET=

# --- Mixpanel: local overrides (Vercel production defaults live in next.config.ts) ---
# NEXT_PUBLIC values are baked into the browser bundle; rebuild after changing.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_MIXPANEL_TOKEN=
# US (default) or EU: match the region selected when creating the project.
NEXT_PUBLIC_MIXPANEL_REGION=US
NEXT_PUBLIC_ANALYTICS_ENVIRONMENT=development
# Comma-separated Supabase user UUIDs, not emails. Filter is_internal=false in reports.
NEXT_PUBLIC_ANALYTICS_INTERNAL_USER_IDS=
